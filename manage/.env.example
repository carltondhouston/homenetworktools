# ──────────────────────────────────────────────────────────────
#  network_audit — environment configuration
#  Copy this file to .env and fill in your values.
#  Never commit .env to version control.
# ──────────────────────────────────────────────────────────────

# ── Portainer ──────────────────────────────────────────────────
# Base URL of your Portainer instance
PORTAINER_URL=https://canister:9443

# API token — Portainer UI → Settings → My Account → API tokens
PORTAINER_TOKEN=ptr_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of Portainer environment names to audit
PORTAINER_HOSTS=canister,doodoo

# ── phpIPAM ────────────────────────────────────────────────────
# Base URL (no trailing slash)
PHPIPAM_URL=http://phpipam.chcasa.us

# API app ID — phpIPAM → Administration → API → App ID
PHPIPAM_APP=audit

# Static app token — shown in phpIPAM → Administration → API after creating the app.
# The app's "App security" must be set to "SSL with App token" (not "User token").
PHPIPAM_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── UniFi / UDM Pro ────────────────────────────────────────────
UNIFI_URL=https://192.168.1.1
UNIFI_SITE=default

# API key — Network Application → Settings → Integrations → API Keys
# Requires UniFi OS console (UDM, UDR, UCG, etc.) running Network Application 8.x+
UNIFI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
